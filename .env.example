# OrderFlow AI — environment configuration
#
# Copy this file to `.env.local` and fill in the values from your Supabase project
# (Project Settings -> API).
#
# SECURITY: Only the public browser key belongs in the frontend. Never add the
# service-role/secret key, database password, access token, or AI provider keys
# to Vite variables — anything prefixed with VITE_ is bundled into the browser.
#
# VITE_SUPABASE_ANON_KEY accepts either the legacy anon key or the newer
# publishable key (sb_publishable_...).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public Meta Embedded Signup configuration. These values are browser-safe.
# Meta app secret, webhook verify token and service-role keys are Edge Function secrets only.
VITE_META_APP_ID=
VITE_META_CONFIG_ID=
VITE_META_GRAPH_API_VERSION=v25.0
VITE_META_EMBEDDED_SIGNUP_VERSION=v4

# AI assistant Edge Function secrets. These are NOT Vite variables and must never be
# placed in .env.local for the browser. Set them with the Supabase CLI:
#   supabase secrets set AI_PROVIDER=openai_compatible
#   supabase secrets set AI_API_KEY=...
#   supabase secrets set AI_BASE_URL=https://api.provider.test/v1
#   supabase secrets set AI_MODEL=...
# Optional: AI_TIMEOUT_MS, AI_MAX_OUTPUT_TOKENS, AI_JSON_MODE, AI_ALLOWED_ORIGINS,
# AI_COST_PER_MILLION_INPUT_TOKENS, AI_COST_PER_MILLION_OUTPUT_TOKENS.
# Daily request/token limits are stored per business in public.ai_assistant_settings.
# The assistant returns PROVIDER_NOT_CONFIGURED until a provider is configured.
